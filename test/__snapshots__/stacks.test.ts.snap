    "OnPremisesVpcVpnRouterB775D515": {
      "Properties": {
        "IamInstanceProfile": {
          "Ref": "OnPremisesVpcVpnRouterInstanceProfileA477EE32",
        },
        "ImageId": {
          "Ref": "SsmParameterValueawsserviceamiamazonlinuxlatestal2023amikernel61x8664C96584B6F00A464EAD1953AFF4B05118Parameter",
        },
        "InstanceType": "t3.small",
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "NetworkInterfaceId": {
              "Ref": "OnPremisesVpcRouterEth0EF12D9B2",
            },
          },
          {
            "DeviceIndex": "1",
            "NetworkInterfaceId": {
              "Ref": "OnPremisesVpcRouterEth1E371742D",
            },
          },
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Join": [
              "",
              [
                "#!/bin/bash
IMDS_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
CREDENTIALS_READY=0
for i in $(seq 1 30); do
  CREDS=$(curl -s -H "X-aws-ec2-metadata-token: \${IMDS_TOKEN}" http://169.254.169.254/latest/meta-data/iam/security-credentials/)
  if [ -n "\${CREDS}" ]; then
    CREDENTIALS_READY=1
    break
  fi
  echo "Waiting for IMDS credentials... (\${i}/30)"
  sleep 2
done
if [ "\${CREDENTIALS_READY}" != "1" ]; then
  echo "WARNING: IMDS credentials did not become available within the retry budget" >&2
fi
cat <<EOF > /etc/vpn-router.env
ONPREM_VPC_CIDR=10.100.0.0/16
ROUTER_ASN=65000
VPN_SEARCH_REGIONS=ap-northeast-1,ap-northeast-3
VPN_NAME_TAG_KEY=Name
VPN_NAME_TAG_VALUES=apne1-tgw-vpn,apne3-tgw-vpn
PRIMARY_AWS_ASN=64512
SECONDARY_AWS_ASN=64513
EOF
mkdir -p "$(dirname '/opt/set-return-path.sh')"
DOWNLOAD_OK=0
for i in $(seq 1 10); do
  if aws s3 cp 's3://",
                {
                  "Fn::Sub": "cdk-hnb659fds-assets-\${AWS::AccountId}-\${AWS::Region}",
                },
                "/20563be0e562e57c4182fc708c8aea409930e32baf9ef53dd9e40d1135ef78f2.sh' '/opt/set-return-path.sh'; then
    DOWNLOAD_OK=1
    break
  fi
  echo "S3 download retry (\${i}/10): /opt/set-return-path.sh"
  sleep 5
done
if [ "\${DOWNLOAD_OK}" != "1" ]; then
  echo "ERROR: failed to download /opt/set-return-path.sh from S3" >&2
  exit 1
fi
chmod +x '/opt/set-return-path.sh'
mkdir -p "$(dirname '/opt/vpn-router-bootstrap.sh')"
DOWNLOAD_OK=0
for i in $(seq 1 10); do
  if aws s3 cp 's3://",
                {
                  "Fn::Sub": "cdk-hnb659fds-assets-\${AWS::AccountId}-\${AWS::Region}",
                },
                "/5b72585260116166ab23efd28d0850e0d9755bf8671a38ab99ecf99b710f1510.sh' '/opt/vpn-router-bootstrap.sh'; then
    DOWNLOAD_OK=1
    break
  fi
  echo "S3 download retry (\${i}/10): /opt/vpn-router-bootstrap.sh"
  sleep 5
done
if [ "\${DOWNLOAD_OK}" != "1" ]; then
  echo "ERROR: failed to download /opt/vpn-router-bootstrap.sh from S3" >&2
  exit 1
fi
chmod +x '/opt/vpn-router-bootstrap.sh'
cat <<EOF > /etc/systemd/system/vpn-router-converge.service
[Unit]
Description=Re-run vpn-router-bootstrap.sh until all 4 tunnels are established

[Service]
Type=oneshot
ExecStart=/opt/vpn-router-bootstrap.sh
StandardOutput=append:/var/log/vpn-router-bootstrap.log
StandardError=append:/var/log/vpn-router-bootstrap.log
EOF
cat <<EOF > /etc/systemd/system/vpn-router-converge.timer
[Unit]
Description=Retry vpn-router-bootstrap.sh every 5 minutes until convergence

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min
Unit=vpn-router-converge.service

[Install]
WantedBy=timers.target
EOF
systemctl daemon-reload
echo pending:timer-installed > /run/vpn-router-status
systemctl enable --now vpn-router-converge.timer",
              ],
            ],
          },
        },
      },
