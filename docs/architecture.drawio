        <mxCell id="JqVBP9h8yWY48RqrwmX7-75" parent="JqVBP9h8yWY48RqrwmX7-1" style="html=1;shape=mxgraph.basic.rectCallout;dx=55.5;dy=42;boundedLbl=1;align=left;labelWidth=1;spacing=10;" value="&lt;span style=&quot;font-size: 17px; text-wrap-mode: nowrap;&quot;&gt;us-west-2 CNEからap-northeast-1 CNE&lt;/span&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;に広告する経路&lt;/span&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;について&lt;/span&gt;&lt;span style=&quot;font-size: 17px; text-wrap-mode: nowrap;&quot;&gt;&lt;br&gt;us-west-2 CNEのASNである &lt;span style=&quot;color: rgb(0, 127, 255);&quot;&gt;64523&lt;/span&gt;&amp;nbsp;および&lt;/span&gt;&lt;span style=&quot;font-size: 17px; white-space: nowrap;&quot;&gt;オンプレミス相当VPCのASNである&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 17px; white-space: nowrap; color: rgb(0, 127, 255);&quot;&gt;65001 &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 17px; white-space: nowrap;&quot;&gt;が&lt;/span&gt;&lt;span style=&quot;font-size: 17px; text-wrap-mode: nowrap;&quot;&gt;含まれているため&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 36, 20); font-size: 17px; white-space: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;4200000001&lt;/span&gt;&lt;span style=&quot;font-size: 17px; text-wrap-mode: nowrap;&quot;&gt;&amp;nbsp;をAS_PATH Prepend&lt;/span&gt;&lt;span style=&quot;font-size: 17px; text-wrap-mode: nowrap;&quot;&gt;&lt;br&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="131" width="637" x="826" y="494" as="geometry" />
