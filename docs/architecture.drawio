        <mxCell id="JqVBP9h8yWY48RqrwmX7-73" connectable="0" parent="JqVBP9h8yWY48RqrwmX7-72" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];labelPosition=right;verticalLabelPosition=middle;labelBorderColor=none;spacing=10;" value="&lt;span style=&quot;font-size: 17px; text-align: left;&quot;&gt;&lt;b&gt;[us-west-2 CNE 経由]&lt;/b&gt;&lt;br&gt;- PREFIX : 10.200.0.0/16&lt;/span&gt;&lt;br style=&quot;font-size: 17px; text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;- &lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;AS_PATH : &lt;span style=&quot;color: rgb(255, 36, 20);&quot;&gt;4200000001&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;color: rgb(0, 127, 255);&quot;&gt;64523&lt;/span&gt; 64514 &lt;span style=&quot;color: rgb(0, 127, 255);&quot;&gt;65001&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;- &lt;/span&gt;&lt;span style=&quot;font-size: 17px; text-align: left;&quot;&gt;LP : 0&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;- &lt;/span&gt;&lt;span style=&quot;font-size: 17px; text-align: left;&quot;&gt;MED : 100&lt;/span&gt;" vertex="1">
